# Local dev only — production uses managed Neon Postgres (separate URL,
# never committed). POSTGRES_PASSWORD below must match the password in this
# URL; docker-compose.yml refuses to start without it set, and binds the
# port to 127.0.0.1 only. Pick a real random password, not "gotrid".
POSTGRES_PASSWORD="change-me-to-a-random-32-byte-secret"
DATABASE_URL="postgresql://gotrid:change-me-to-a-random-32-byte-secret@localhost:5432/gotrid?schema=public"

# Public site URL, used in feeds/sitemap/canonical tags
NEXT_PUBLIC_SITE_URL="https://gotridperfume.cz"

# Meta Pixel + Conversions API — business.facebook.com → Events Manager
NEXT_PUBLIC_META_PIXEL_ID="1360549122422284"
META_CONVERSIONS_API_TOKEN=""

# Microsoft Clarity (session recordings + heatmaps) — clarity.microsoft.com →
# create a project for the site → Settings → copy Project ID
NEXT_PUBLIC_CLARITY_PROJECT_ID=""

# Heureka Ověřeno zákazníky — Heureka Business Center
HEUREKA_OVERENO_API_KEY=""

# Seznam Sklik retargeting + conversion measurement — Sklik account →
# Nástroje → Retargeting (rtgId) and Nástroje → Sledování konverzí (id)
NEXT_PUBLIC_SKLIK_RETARGETING_ID=""
NEXT_PUBLIC_SKLIK_CONVERSION_ID=""

# Zboží.cz conversion tracking (github.com/seznam/zbozi-konverze) — Zboží.cz
# seller admin → integration section
NEXT_PUBLIC_ZBOZI_SHOP_ID=""
ZBOZI_SECRET_KEY=""

# Stripe (card payments) — Dashboard → Developers → API keys / Webhooks
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Zásilkovna / Packeta — client.packeta.com
NEXT_PUBLIC_PACKETA_API_KEY=""
PACKETA_API_PASSWORD=""

# Resend (transactional email) — resend.com → API Keys
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Gotrid Perfume <objednavky@gotridperfume.cz>"

# Bank account for QR platba (bank transfer), IBAN format
BANK_IBAN=""

# Admin panel (/admin) — generate a random secret, pick your own password
ADMIN_SESSION_SECRET=""
ADMIN_PASSWORD=""

# Vercel Cron auth for /api/cron/* routes (e.g. daily SP Venture stock sync)
# — generate a random secret and set the SAME value in Vercel's project env
# vars; Vercel then sends it automatically as a Bearer token on cron-triggered
# requests, so nobody else can trigger these routes.
CRON_SECRET=""

# Customer accounts (/prihlaseni, /muj-ucet) — generate a random secret
CUSTOMER_SESSION_SECRET=""

# Instagram feed in the footer (optional — without these the footer just
# shows a plain link to the profile). Setup:
#   1. Make sure the Instagram account is a Business/Creator account linked
#      to a Facebook Page.
#   2. Create an app at developers.facebook.com (type "Business").
#   3. Add the "Instagram Graph API" product, generate a long-lived access
#      token, and grab the Instagram account's numeric ID.
# The token expires after ~60 days and needs refreshing (Graph API has a
# /refresh_access_token endpoint) — there's no auto-refresh wired up here yet.
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_BUSINESS_ACCOUNT_ID=""
